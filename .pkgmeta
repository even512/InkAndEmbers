# BigWigs packager configuration (https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File)
# The repository keeps the three addons below addon/; the release zip contains them as three top-level folders:
#   InkAndEmbers/               main addon (MIT, graphics: all rights reserved)
#   InkAndEmbers_QuestData/     quest data (GPL-3.0, LoadOnDemand)
#   InkAndEmbers_Data/          enemy and item lists (GPL-3.0, LoadOnDemand)
package-as: InkAndEmbers

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

enable-nolib-creation: no

# QuestieDB (CurseForge slug questiedb) is optional: in WoW Forever the open quests are read from it when it is installed,
# otherwise from InkAndEmbers_QuestData. Not required: the same file is uploaded for Retail, where QuestieDB does not exist.
optional-dependencies:
  - questiedb

move-folders:
  InkAndEmbers/addon/InkAndEmbers: InkAndEmbers
  InkAndEmbers/addon/InkAndEmbers_QuestData: InkAndEmbers_QuestData
  InkAndEmbers/addon/InkAndEmbers_Data: InkAndEmbers_Data

# Everything outside the addon folders stays out of the zip, plus the development simulation
# (journal/SimPanel.lua and journal/FireProbe.lua; their TOC lines are removed by the #@do-not-package@ block in the TOC).
ignore:
  - addon/InkAndEmbers/journal/SimPanel.lua
  - addon/InkAndEmbers/journal/FireProbe.lua
  - .github
  - .gitignore
  - .gitattributes
  - .env.example
  - art
  - docs
  - scripts
  - tests
  - node_modules
  - CHECKPOINT.md
  - README.md
  - LICENSE
  - package.json
  - package-lock.json
  - vitest.config.mjs
