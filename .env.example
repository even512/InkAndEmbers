# Pfad zum WoW-Ordner (enthaelt _forever_ bzw. _retail_), z. B. D:\World of Warcraft
WOW_DIR=

# Nur fuer "npm run data" (Questdaten neu erzeugen, siehe README). Alles optional, absolute Pfade.
# Die QuestieDB selbst holt "npm run data" automatisch als STABILES GitHub-Release (SHA-256 geprueft, kein Preview-Kanal)
# nach data-capture\questiedb-release; dieses Release hat Vorrang vor den beiden folgenden Quellen.
# Rueckfall: QuestieDB_Forever.toc (sonst wird sie unter WOW_DIR\_forever_\Interface\AddOns\QuestieDB gesucht)
CHRONICLE_QUESTIE_TOC=
# Ordner mit dem Forever-Datenbank-Dump (zones.json, l10n\deDE\search.json, quest\*.json, search.json)
CHRONICLE_FOREVER_DB=
# Ordner mit wago.tools-Tabellen (Standard: der Schnappschuss unter scripts\data)
CHRONICLE_OVERLAYS=
CHRONICLE_OVERLAYS_RETAIL=
